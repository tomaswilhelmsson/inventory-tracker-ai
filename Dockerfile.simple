# Simple single-container Dockerfile for Inventory Tracker
# Everything in one container - like your WooCommerce app!

FROM node:20-alpine

# Install OpenSSL for Prisma and a simple web server
RUN apk add --no-cache openssl dumb-init
RUN npm install -g http-server

WORKDIR /app

# Copy and install backend
COPY package*.json ./
COPY backend ./backend
RUN npm ci

# Generate Prisma client
RUN cd backend && npx prisma generate

# Build backend (continue even if there are type errors)
RUN npx tsc -p backend/tsconfig.docker.json || (echo "Build completed with warnings" && exit 0)

# Copy and build frontend
COPY frontend ./frontend
# Build frontend to use relative API URL (will be proxied by http-server)
RUN cd frontend && npm ci && VITE_API_URL=/api npm run build:docker

# Set up database directory
RUN mkdir -p backend/data

# Expose port 3000 (backend) and 8080 (frontend)
EXPOSE 3000 8080

# Use dumb-init for proper signal handling
ENTRYPOINT ["dumb-init", "--"]

# Start both backend and frontend
CMD sh -c "cd backend && mkdir -p data && npx prisma generate && npx prisma migrate deploy && node dist/server.js & http-server frontend/dist -p 8080 --proxy http://localhost:3000 && wait"
