# Database Configuration
# For local development (SQLite):
DATABASE_URL="file:./data/inventory.db"
# For Docker/Production (PostgreSQL):
# DATABASE_URL="postgresql://inventory:inventory@postgres:5432/inventory"
DATABASE_PROVIDER="sqlite"  # sqlite or mysql (for MariaDB) or postgresql

# PostgreSQL Configuration (for Docker)
POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory
POSTGRES_DB=inventory
POSTGRES_PORT=5432

# Server Configuration
PORT=3000
NODE_ENV="development"

# Authentication
JWT_SECRET="your-secret-key-change-in-production"
BCRYPT_ROUNDS=10

# Google Cloud Storage (for backups)
GCS_BUCKET_NAME="your-gcs-bucket-name"
GCS_KEY_FILE="./path-to-service-account-key.json"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# VAT Configuration
# Default VAT rate as decimal (e.g., 0.25 for 25%, 0.20 for 20%)
# Set to 0 for VAT-exempt regions
DEFAULT_VAT_RATE=0.25

# Docker Configuration
# Frontend port (nginx)
FRONTEND_PORT=8080
# API URL for frontend (used during Docker build)
VITE_API_URL=http://localhost:3000
