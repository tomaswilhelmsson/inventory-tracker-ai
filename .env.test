# Docker Environment Configuration
# Copy this file to .env and update the values

# PostgreSQL Database Configuration
POSTGRES_USER=inventory
POSTGRES_PASSWORD=change-this-secure-password
POSTGRES_DB=inventory
POSTGRES_PORT=5432

# Database URL (for Prisma)
DATABASE_URL=postgresql://inventory:change-this-secure-password@postgres:5432/inventory

# Authentication
JWT_SECRET=change-this-to-a-long-random-secret-key
BCRYPT_ROUNDS=10

# Server Configuration
PORT=3000
NODE_ENV=production

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8080

# Frontend Configuration
FRONTEND_PORT=8080
VITE_API_URL=http://localhost:3000

# VAT Configuration
DEFAULT_VAT_RATE=0.25

# Optional: Google Cloud Storage (for backups)
# GCS_BUCKET_NAME=your-gcs-bucket-name
# GCS_KEY_FILE=./path-to-service-account-key.json

# Optional: Additional CORS Origins (comma-separated)
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
